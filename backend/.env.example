PORT=4000
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1d
NODE_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=custodian
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@custodian.local
FRONTEND_BASE_URL=http://localhost:3001
# Local document + OCR text files (default: ./storage under backend cwd)
STORAGE_ROOT=
# Tesseract.js (open-source OCR): language packs, e.g. eng or eng+sin
OCR_LANGUAGES=eng
# Max PDF pages to OCR when embedded text is missing/thin
OCR_PDF_MAX_PAGES=30
# Raster scale for PDF→image before OCR (1–4)
OCR_VIEWPORT_SCALE=2

# File logging (default: ./logs/app.log under backend cwd)
# LOG_DIR=./logs
# LOG_FILE=app.log
# LOG_LEVEL=info
# LOG_HTTP=1
# LOG_TO_FILE=1

# Meilisearch (global content search) — run: docker run -d -p 7700:7700 getmeili/meilisearch:latest
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_UID=custodian_documents
